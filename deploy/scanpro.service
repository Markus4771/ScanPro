[Unit]
Description=ScanPro 1.0 API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=scanpro
Group=scanpro
WorkingDirectory=/opt/scanpro
Environment=PYTHONUNBUFFERED=1
Environment=SCANPRO_DATA_ROOT=/var/lib/scanpro-v1
Environment=SCANPRO_DATABASE_URL=sqlite:////var/lib/scanpro-v1/scanpro-v1.db
ExecStart=/opt/scanpro/.venv/bin/uvicorn scanpro.main:app --host 127.0.0.1 --port 8100
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
