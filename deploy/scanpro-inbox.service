[Unit]
Description=ScanPro 1.0 Inbox Worker
After=network-online.target smbd.service
Wants=network-online.target

[Service]
Type=simple
User=scanpro
Group=scanpro
WorkingDirectory=/opt/scanpro
Environment=PYTHONUNBUFFERED=1
Environment=SCANPRO_DATA_ROOT=/var/lib/scanpro-v1
Environment=SCANPRO_DATABASE_URL=sqlite:////var/lib/scanpro-v1/scanpro-v1.db
ExecStart=/opt/scanpro/.venv/bin/python -m scanpro.inbox_worker
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
