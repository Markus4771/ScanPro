[Unit]
Description=ScanPro Scan Station
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=scanpro
Group=scanpro
WorkingDirectory=/opt/scanpro
Environment=PYTHONUNBUFFERED=1
Environment=HOME=/var/lib/scanpro
Environment=XDG_CONFIG_HOME=/var/lib/scanpro/.config
Environment=XDG_CACHE_HOME=/var/lib/scanpro/.cache
ExecStart=/opt/scanpro/.venv/bin/uvicorn scanpro.main:app --host 127.0.0.1 --port 8100
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
